# Salin menjadi .env untuk development lokal: cp .env.example .env
# .env tidak di-commit (lihat .gitignore). Production tidak memakai file ini:
# isi repository variable di GitHub (Settings > Secrets and variables > Actions > Variables).
# Nilai dibaca saat build/dev server mulai, jadi restart server setelah mengubahnya.

# Alamat Prasetya Platform, tanpa garis miring di akhir dan tanpa /api/v1.
# Kosong = pembayaran online mati, form order hanya menawarkan konsultasi WhatsApp.
#
# Lokal: samakan dengan APP_URL platform. Di platform, CORS_ALLOWED_ORIGINS harus memuat
# http://localhost:4322 dan PAYMENT_RETURN_URL_SATAMU=http://localhost:4322/order/status/.
# Jalankan Satamu dengan: npm run dev -- --port 4322
#
# Production: https://platform.prasetyawebworks.web.id
PUBLIC_PLATFORM_API_URL=
