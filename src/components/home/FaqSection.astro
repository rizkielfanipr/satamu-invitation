---
import { Plus } from 'lucide-react';
import SectionIntro from '../ui/SectionIntro.astro';
import { content, type Locale } from '../../i18n/content';

interface Props {
	locale: Locale;
}

const t = content[Astro.props.locale].faq;
---

<section class="bg-card scroll-mt-20 px-6 py-16 md:px-8 md:py-24 lg:px-10" id="faq" aria-labelledby="faq-title">
	<div class="mx-auto max-w-6xl">
		<SectionIntro id="faq-title" eyebrow={t.eyebrow} title={t.title} emphasis={t.emphasis} description={t.description} />
		{/* Native <details> accordion: works without JavaScript; the plus turns into a cross when open. */}
		<div class="grid gap-3">
			{t.items.map((item) => (
				<details class="group bg-card open:border-primary/45 rounded-lg border transition-colors motion-reduce:transition-none">
					<summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 px-5 py-4 [&::-webkit-details-marker]:hidden">
						<span class="text-base leading-snug font-semibold">{item.question}</span>
						<span class="bg-primary text-primary-foreground grid size-7 shrink-0 place-items-center rounded-full transition-transform duration-300 group-open:rotate-45 motion-reduce:transition-none">
							<Plus className="size-4" strokeWidth={2.5} aria-hidden="true" />
						</span>
					</summary>
					<p class="text-muted-foreground max-w-3xl px-5 pb-5 text-[15px] leading-[1.75]">{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>
