---
import { MessageCircleHeart, Palette, PenLine, Send } from 'lucide-react';
import PhoneMockup from './PhoneMockup.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { content, type Locale } from '../../i18n/content';
import { site } from '../../config/site';
import { whatsappUrl } from '../../scripts/whatsapp';

interface Props {
	locale: Locale;
}

const all = content[Astro.props.locale];
const t = all.hero;
const price = all.packages.items[0].price;
const m = t.mockup;
// One icon per step, in the order of hero.steps.
const stepIcons = [Palette, PenLine, Send];
---

{/* overflow-x-clip keeps the tilted phones from widening the page on small screens. */}
<section class="bg-satamu-hero overflow-x-clip">
	<div class="mx-auto grid min-h-dvh max-w-6xl grid-cols-[minmax(0,1fr)] items-center gap-14 px-6 pt-32 pb-20 md:px-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-10 lg:px-10 lg:pt-36">
		<div>
			<h1 class="font-display max-w-2xl text-[clamp(1.875rem,10vw,2.25rem)] leading-[1.05] font-semibold tracking-[-0.7px] text-balance md:text-5xl md:leading-none md:tracking-[-1px] lg:text-6xl lg:tracking-[-1.5px]">
				{/* Astro drops the plain spaces between these inline parts, so each part carries its own. */}
				{`${t.lead} `}
				<span class="font-medium italic">{`${t.connector} `}</span>
				<em class="text-primary font-semibold italic">{t.emphasis}</em>
			</h1>
			<p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1" aria-label={`${t.pricePrefix} ${price}, ${t.priceSuffix}`}>
				<span class="text-xs font-bold tracking-[0.14em] uppercase" aria-hidden="true">
					{t.pricePrefix}
				</span>
				<strong class="font-display text-[clamp(1.9rem,3vw,3rem)] leading-none font-bold tracking-[-0.04em]" aria-hidden="true">
					{price}
				</strong>
				<span class="text-muted-foreground basis-full text-sm font-semibold sm:basis-auto" aria-hidden="true">
					{t.priceSuffix}
				</span>
			</p>

			{/* An <a> styled with the shadcn Button variants: no React or JavaScript needed for a link. */}
			<a
				class={cn(
					buttonVariants({ size: 'lg' }),
					'shadow-brand mt-8 h-12 gap-3 rounded-lg px-6 text-sm font-semibold hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0',
				)}
				href={whatsappUrl(t.message.replace('{site}', site.name))}
				target="_blank"
				rel="noopener"
			>
				{t.primary} <span aria-hidden="true">↗</span>
			</a>

			<ol class="mt-12 grid gap-7" aria-label={t.stepsLabel}>
				{t.steps.map((step, index) => {
					const Icon = stepIcons[index];
					return (
						<li class="relative grid grid-cols-[2.75rem_minmax(0,1fr)] gap-4">
							{/* Line linking this step to the next one. */}
							{index < t.steps.length - 1 && (
								<span class="bg-border absolute top-12 bottom-[-1.5rem] left-[1.375rem] w-px" aria-hidden="true" />
							)}
							<span class="border-border bg-card text-primary grid size-11 place-items-center rounded-full border">
								<Icon className="size-5" aria-hidden="true" />
							</span>
							<div class="pt-1">
								<p class="text-sm leading-[1.43] font-semibold">{step.title}</p>
								<p class="text-muted-foreground mt-1 text-sm leading-[1.6]">{step.description}</p>
							</div>
						</li>
					);
				})}
			</ol>
		</div>

		<div class="relative mx-auto h-[23rem] w-full max-w-md min-[400px]:h-[26rem] sm:h-[34rem]" aria-hidden="true">
			{/* Below 640px the whole phone group scales down so the tilted side phones stay on screen; the card below keeps its size. */}
			<div class="absolute inset-x-0 top-0 h-[34rem] origin-top scale-[0.62] min-[400px]:scale-[0.72] sm:scale-100">
				<PhoneMockup
					theme="navy"
					label={m.label}
					first={m.left.first}
					second={m.left.second}
					date={m.left.date}
					class="absolute top-12 left-1/2 w-48 -translate-x-[115%] -rotate-[7deg] opacity-95"
				/>
				<PhoneMockup
					theme="coral"
					label={m.label}
					first={m.right.first}
					second={m.right.second}
					date={m.right.date}
					class="absolute top-12 left-1/2 w-48 translate-x-[15%] rotate-[7deg] opacity-95"
				/>
				<PhoneMockup
					theme="cream"
					label={m.label}
					first={m.main.first}
					second={m.main.second}
					date={m.main.date}
					guest={{ to: m.to, name: m.guest, open: m.open }}
					class="absolute top-0 left-1/2 z-10 w-60 -translate-x-1/2"
				/>
			</div>
			<div class="border-border bg-card absolute bottom-0 left-0 z-20 flex w-64 items-start gap-3 rounded-lg border p-4 shadow-[0_20px_40px_-20px_rgb(16_42_67/35%)] sm:bottom-10 sm:left-1/2 sm:-translate-x-[95%]">
				<MessageCircleHeart className="text-primary mt-0.5 size-5 shrink-0" />
				<div>
					<p class="text-muted-foreground text-xs font-semibold">{m.sentTitle}</p>
					<p class="mt-0.5 text-sm font-semibold">{m.sentName}</p>
					<p class="text-muted-foreground text-xs">{m.sentDetail}</p>
				</div>
			</div>
		</div>
	</div>
</section>
