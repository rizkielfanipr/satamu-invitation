---
import { content, type Locale } from '../../i18n/content';
import { site } from '../../config/site';
import { whatsappUrl } from '../../scripts/whatsapp';

interface Props {
	locale: Locale;
}

const t = content[Astro.props.locale].hero;
---

<section class="hero section-pad">
	<img class="hero-logo" src={site.logo} alt={site.name} width="2400" height="900" />
	<p class="hero-eyebrow">
		{t.eyebrow} · {t.soon}
	</p>
	<h1>
		{t.title}
		<em>{t.emphasis}</em>
	</h1>
	<p class="hero-description">{t.description}</p>
	<a class="hero-button" href={whatsappUrl(t.message.replace('{site}', site.name))} target="_blank" rel="noopener">
		{t.primary} <span aria-hidden="true">↗</span>
	</a>
</section>

<style>
	.hero {
		min-height: calc(100dvh - 5rem);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		background:
			radial-gradient(circle at 80% 15%, rgba(255, 101, 66, 0.16), transparent 32%),
			radial-gradient(circle at 10% 90%, rgba(16, 42, 67, 0.08), transparent 30%), var(--background);
	}

	.hero-logo {
		width: min(320px, 70vw);
		margin-bottom: 2.5rem;
	}

	.hero-eyebrow {
		margin: 0 0 1rem;
		color: var(--primary);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.hero h1 {
		max-width: 760px;
		margin: 0;
		font-size: clamp(2.2rem, 5.5vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
	}

	.hero h1 em {
		display: block;
		color: var(--primary);
		font-weight: 600;
	}

	.hero-description {
		max-width: 560px;
		margin: 1.25rem auto 0;
		color: var(--muted);
		font-size: clamp(1rem, 1.4vw, 1.1rem);
		line-height: 1.7;
	}

	.hero-button {
		min-height: 52px;
		margin-top: 2rem;
		padding: 0.85rem 1.6rem;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--primary-foreground);
		background: var(--primary);
		border-radius: var(--radius);
		box-shadow: 0 10px 15px -3px rgba(255, 101, 66, 0.3);
		font-weight: 800;
		text-decoration: none;
		transition: transform 180ms ease;
	}

	.hero-button:hover {
		transform: translateY(-2px);
	}

	.hero-button:focus-visible {
		outline: 2px solid var(--foreground);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-button {
			transition: none;
		}
	}
</style>
