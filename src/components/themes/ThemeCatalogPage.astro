---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SiteFooter from '../layout/SiteFooter.astro';
import SectionIntro from '../ui/SectionIntro.astro';
import ThemeGrid from './ThemeGrid.astro';
import { content, type Locale } from '../../i18n/content';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const all = content[locale];
const c = all.catalog;
---

<Layout lang={locale} title={c.metaTitle} description={c.metaDescription}>
	<SiteHeader locale={locale} onHome={false} />
	<main class="bg-satamu-hero px-6 pt-32 pb-20 md:px-8 lg:px-10 lg:pt-36" id="top">
		<div class="mx-auto max-w-6xl">
			<SectionIntro
				id="catalog-title"
				level="h1"
				eyebrow={all.themes.eyebrow}
				title={c.title}
				emphasis={c.emphasis}
				description={all.themes.description}
			/>
			<ThemeGrid locale={locale} />
		</div>
	</main>
	<SiteFooter locale={locale} onHome={false} />
</Layout>
